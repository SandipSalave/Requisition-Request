        <condition/>
        <description> A error if record is added to a candidate profile named custom table the filed should be switched to in progress after that a user can add many records to the candidate profile table</description>
        <field/>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>state field to progress</name>
        <order/>
        <script><![CDATA[function onLoad() {
    // Check if the record is associated with a Candidate Profile
    var candidateProfile = g_form.getReference('candidate_profile'); // Replace 'candidate_profile' with the actual field name

    if (candidateProfile) {
        // Check if the state field is not "In Progress"
        if (g_form.getValue('state') != 'Work in Progress') {
            g_form.showFieldMsg('state', 'State must be "Work in Progress" for records associated with a Candidate Profile.', 'error');
        }
    }
}]]></script>
